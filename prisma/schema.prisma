generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // ÖNEMLİ: Prisma 7 + driver adapter (@prisma/adapter-pg) kullanılıyor
  // olsa da (bkz. src/lib/prisma.ts), `prisma generate` / `prisma migrate`
  // / `prisma db push` gibi CLI komutları schema.prisma'da bir `url` alanı
  // BEKLER — yoksa şema doğrulaması ve migration üretimi başarısız olabilir.
  // Gerçek çalışma zamanı bağlantısı yine de PrismaPg adapter'a verilen
  // connectionString (POSTGRES_PRISMA_URL / DATABASE_URL) üzerinden kurulur;
  // buradaki url sadece CLI/tooling için gereklidir.
  url      = env("DATABASE_URL")
}

model HealthArticle {
  id        Int      @id @default(autoincrement())
  slug      String   @unique
  title     String
  img       String
  date      String
  readTime  String
  category  String
  desc      String
  intro     String
  sections  Json
  tags      String[]
  lang      String   @default("tr")
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // getHealthArticleBundle() içindeki "related articles" sorgusu
  // (where: { published, lang }, orderBy: { createdAt: 'desc' }) bu
  // index olmadan sıralı full-table scan yapıyordu. slug zaten @unique
  // olduğu için ayrıca index gerekmiyor.
  @@index([lang, published, createdAt])
}

model Treatment {
  id        Int      @id @default(autoincrement())
  slug      String   @unique
  title     String
  img       String
  images    String[]
  category  String
  stats     Json
  desc      Json
  symptoms  String[]
  treatment Json
  faq       Json
  lang      String   @default("tr")
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Liste sayfası (/tedaviler, /treatments) ve olası "ilgili tedaviler"
  // sorguları için.
  @@index([lang, published])
}

model PressItem {
  id        Int      @id @default(autoincrement())
  outlet    String
  title     String
  summary   String
  date      String
  format    String
  image     String
  href      String
  lang      String   @default("tr")
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([lang, published])
}

model Presentation {
  id        Int      @id @default(autoincrement())
  year      String
  title     String
  congress  String
  location  String
  type      String
  language  String
  topic     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model GalleryItem {
  id          Int      @id @default(autoincrement())
  img         String
  title_tr    String
  title_en    String?
  category_tr String
  category_en String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model HomeResult {
  id        Int      @id @default(autoincrement())
  img       String
  label_tr  String
  label_en  String?
  desc_tr   String
  desc_en   String?
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SiteContent {
  id        Int      @id @default(autoincrement())
  filename  String   @unique
  content   Json
  updatedAt DateTime @updatedAt
}

model User {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  password  String
  role      String   @default("ADMIN")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
